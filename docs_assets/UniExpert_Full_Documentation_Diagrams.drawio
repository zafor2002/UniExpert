          <mxGeometry x="480" y="340" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- Audit & Cryptography Component -->
        <mxCell id="comp_audit" value="&lt;b&gt;«component»&lt;br&gt;Merkle Audit &amp;amp; BAETE Compiler&lt;/b&gt;&lt;br&gt;[SHA-256 Ledger / ReportLab]" style="shape=module;align=left;spacingLeft=20;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#15803D;fontStyle=1;fontSize=11;" vertex="1" parent="1">
