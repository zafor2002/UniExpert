        <mxCell id="df8" value="Hash Block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p3" target="ds_merkle" />
        <mxCell id="df9" value="Verify Root" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ds_merkle" target="p5" />
        <mxCell id="df10" value="BAETE Dossier" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p5" target="ent_auditor" />

