        <!-- Client Component -->
        <mxCell id="comp_client" value="&lt;b&gt;«component»&lt;br&gt;Frontend Single Page App&lt;/b&gt;&lt;br&gt;[React 19 / Vite / Tailwind]" style="shape=module;align=left;spacingLeft=20;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;fontSize=11;" vertex="1" parent="1">
