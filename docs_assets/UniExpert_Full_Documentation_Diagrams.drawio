          <mxGeometry x="480" y="120" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- Inference Component -->
        <mxCell id="comp_ai" value="&lt;b&gt;«component»&lt;br&gt;Inference &amp;amp; XAI Matching&lt;/b&gt;&lt;br&gt;[FastEmbed / Qdrant HNSW]" style="shape=module;align=left;spacingLeft=20;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="120" width="240" height="110" as="geometry" />
