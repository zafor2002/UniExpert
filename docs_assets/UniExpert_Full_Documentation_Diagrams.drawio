        <!-- Real-Time Media Component -->
        <mxCell id="comp_rtc" value="&lt;b&gt;«component»&lt;br&gt;Signaling &amp;amp; Media Hub&lt;/b&gt;&lt;br&gt;[WebSockets / WebRTC Broker]" style="shape=module;align=left;spacingLeft=20;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#C026D3;fontColor=#86198F;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="240" height="110" as="geometry" />
