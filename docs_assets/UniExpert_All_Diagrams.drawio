  <diagram id="page_4_sequence" name="4. Matching Sequence Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="seq_title" value="Sequence Flow: Transformer NLP Extraction, Qdrant Retrieval &amp;amp; XAI Formulation" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- LIFELINES -->
        <mxCell id="ll_student" value="Student Lead&#xa;(Web Browser)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="120" height="650" as="geometry" />
        </mxCell>

        <mxCell id="ll_fe" value="React 19 SPA&#xa;(Frontend UI)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F0F9FF;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="120" height="650" as="geometry" />
        </mxCell>

        <mxCell id="ll_api" value="FastAPI Backend&#xa;(Match Router)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F8FAFC;strokeColor=#475569;fontColor=#1E293B;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="130" height="650" as="geometry" />
        </mxCell>

        <mxCell id="ll_onnx" value="FastEmbed ONNX&#xa;(CPU Inference)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="130" height="650" as="geometry" />
        </mxCell>

        <mxCell id="ll_qdrant" value="Qdrant Vector DB&#xa;(HNSW Cosine)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FDF4FF;strokeColor=#C026D3;fontColor=#86198F;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="890" y="80" width="130" height="650" as="geometry" />
        </mxCell>

        <mxCell id="ll_db" value="SQLite / Postgres&#xa;(Relational DB)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#15803D;fontStyle=1;size=40;" vertex="1" parent="1">
          <mxGeometry x="1080" y="80" width="120" height="650" as="geometry" />
        </mxCell>

        <!-- MESSAGES -->
        <mxCell id="m1" value="1: Input Title &amp;amp; Problem Text (&amp;gt;= 50 words)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0284C7;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="150" as="sourcePoint" />
            <mxPoint x="320" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m2" value="2: POST /api/v1/proposals/extract-entities" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0284C7;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="180" as="sourcePoint" />
            <mxPoint x="535" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m3" value="3: Generate 384-dim dense vector (BAAI/bge-small-en-v1.5)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#D97706;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="535" y="210" as="sourcePoint" />
            <mxPoint x="745" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m4" value="4: Return project vector embedding [&amp;lt; 300ms]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#D97706;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="745" y="250" as="sourcePoint" />
            <mxPoint x="535" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m5" value="5: Vector Search Query (HNSW cosine similarity, top_k=15)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#C026D3;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="535" y="290" as="sourcePoint" />
            <mxPoint x="955" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m6" value="6: Return Faculty Match Corpora &amp;amp; Similarity S_sem [&amp;lt; 50ms]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#C026D3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="955" y="330" as="sourcePoint" />
            <mxPoint x="535" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m7" value="7: Fetch supervisory quotas &amp;amp; tiers (slots_used, slots_total)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#16A34A;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="535" y="370" as="sourcePoint" />
            <mxPoint x="1140" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m8" value="8: Return quota availability &amp;amp; seniority records" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#16A34A;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1140" y="400" as="sourcePoint" />
            <mxPoint x="535" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Activation / Self Calculation -->
        <mxCell id="m9" value="9: Compute XAI S(u,e) = 0.4*S_sem + 0.3*S_skill + 0.15*S_tier + 0.15*S_quota" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="535" y="440" as="sourcePoint" />
            <mxPoint x="555" y="470" as="targetPoint" />
            <Array as="points">
              <mxPoint x="590" y="440" />
              <mxPoint x="590" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="m10" value="10: JSON Response (Ranked Advisors + 4-Axis Radar Metrics)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#0284C7;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="535" y="520" as="sourcePoint" />
            <mxPoint x="320" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m11" value="11: Render Interactive Radar Chart &amp;amp; Explainable Match Cards" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#0284C7;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="560" as="sourcePoint" />
            <mxPoint x="120" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m12" value="12: Select Advisor &amp;amp; Click &quot;Submit Proposal&quot;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#16A34A;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="600" as="sourcePoint" />
            <mxPoint x="320" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m13" value="13: POST /api/v1/proposals (FSM: DRAFT ➔ SUBMITTED + Merkle Audit Log)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#16A34A;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="630" as="sourcePoint" />
            <mxPoint x="535" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m14" value="14: Append SHA-256 Block &amp;amp; Lock Initial Slot" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#16A34A;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="535" y="660" as="sourcePoint" />
            <mxPoint x="1140" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_5_fsm" name="5. Proposal FSM Lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <mxCell id="title" value="UniExpert: Proposal Governance Finite State Machine (FSM) Lifecycle" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
      <mxGeometry x="320" y="30" width="560" height="40" as="geometry" />
    </mxCell>

    <!-- Start state -->
    <mxCell id="s_start" value="" style="ellipse;fillColor=#0F172A;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="80" y="200" width="30" height="30" as="geometry" />
    </mxCell>

    <!-- State: DRAFT -->
    <mxCell id="st_draft" value="DRAFT&#xa;• Proposal unallocated&#xa;• Student can edit narrative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
      <mxGeometry x="170" y="180" width="180" height="70" as="geometry" />
    </mxCell>

    <!-- State: SUBMITTED -->
    <mxCell id="st_sub" value="SUBMITTED&#xa;• Slot reserved tentatively&#xa;• 7-Day review SLA timer active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0369A1;" vertex="1" parent="1">
      <mxGeometry x="430" y="180" width="200" height="70" as="geometry" />
    </mxCell>

    <!-- State: UNDER_REVIEW -->
    <mxCell id="st_review" value="UNDER_REVIEW&#xa;• Student edits locked&#xa;• Advisor inspecting dossier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#854D0E;" vertex="1" parent="1">
      <mxGeometry x="710" y="180" width="190" height="70" as="geometry" />
    </mxCell>

    <!-- State: ACCEPTED -->
    <mxCell id="st_acc" value="ACCEPTED&#xa;• Advisor capacity -1 (Locked)&#xa;• Workspace &amp; Chat spawned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#166534;" vertex="1" parent="1">
      <mxGeometry x="970" y="180" width="190" height="70" as="geometry" />
    </mxCell>

    <!-- State: REVISION_REQ -->
    <mxCell id="st_rev_req" value="REVISION_REQ&#xa;• Re-enables student editing&#xa;• Slot reservation retained" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#9A3412;" vertex="1" parent="1">
      <mxGeometry x="710" y="340" width="190" height="70" as="geometry" />
    </mxCell>

    <!-- State: REJECTED -->
    <mxCell id="st_rej" value="REJECTED&#xa;• Reservation released&#xa;• Student selects next match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#991B1B;" vertex="1" parent="1">
      <mxGeometry x="710" y="470" width="190" height="70" as="geometry" />
    </mxCell>

    <!-- State: ESCALATED -->
    <mxCell id="st_esc" value="ESCALATED&#xa;• 7-Day SLA expired unreviewed&#xa;• Coordinator intervention queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#C026D3;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#86198F;" vertex="1" parent="1">
      <mxGeometry x="430" y="340" width="200" height="70" as="geometry" />
    </mxCell>

    <!-- End state -->
    <mxCell id="s_end" value="" style="ellipse;shape=doubleEllipse;fillColor=#0F172A;strokeColor=#16A34A;strokeWidth=3;" vertex="1" parent="1">
      <mxGeometry x="1050" y="350" width="30" height="30" as="geometry" />
    </mxCell>

    <!-- Transitions -->
    <mxCell id="t0" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="s_start" target="st_draft" />
    <mxCell id="t1" value="Submit Proposal" style="endArrow=classic;html=1;strokeColor=#0284C7;strokeWidth=1.5;fontSize=10;fontColor=#0369A1;fontStyle=1;" edge="1" parent="1" source="st_draft" target="st_sub" />
    <mxCell id="t2" value="Advisor Opens" style="endArrow=classic;html=1;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=10;fontColor=#854D0E;fontStyle=1;" edge="1" parent="1" source="st_sub" target="st_review" />
    <mxCell id="t3" value="Advisor Accepts" style="endArrow=classic;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=10;fontColor=#166534;fontStyle=1;" edge="1" parent="1" source="st_review" target="st_acc" />
    <mxCell id="t4" value="Request Changes" style="endArrow=classic;html=1;strokeColor=#EA580C;strokeWidth=1.5;fontSize=10;fontColor=#9A3412;fontStyle=1;" edge="1" parent="1" source="st_review" target="st_rev_req" />
    <mxCell id="t5" value="Resubmit" style="endArrow=classic;html=1;strokeColor=#0284C7;strokeWidth=1.5;fontSize=10;fontColor=#0369A1;" edge="1" parent="1" source="st_rev_req" target="st_sub" />
    <mxCell id="t6" value="Advisor Rejects" style="endArrow=classic;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;fontColor=#991B1B;fontStyle=1;" edge="1" parent="1" source="st_review" target="st_rej" />
    <mxCell id="t7" value="7-Day SLA Expires" style="endArrow=classic;html=1;strokeColor=#C026D3;strokeWidth=1.5;fontSize=10;fontColor=#86198F;fontStyle=1;" edge="1" parent="1" source="st_sub" target="st_esc" />
    <mxCell id="t8" value="Re-Allocate" style="endArrow=classic;html=1;strokeColor=#C026D3;strokeWidth=1.5;fontSize=10;fontColor=#86198F;" edge="1" parent="1" source="st_esc" target="st_sub" />
    <mxCell id="t9" style="endArrow=classic;html=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="st_acc" target="s_end" />

  </root>
</mxGraphModel>
  </diagram>
  <diagram id="page_6_class" name="6. Domain Class Diagram">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="cls_title" value="UniExpert Domain Class Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- User Class -->
        <mxCell id="c_user" value="User&#xa;--&#xa;+ id: UUID&#xa;+ email: String&#xa;+ password_hash: String&#xa;+ role: RoleEnum&#xa;+ name: String&#xa;+ is_verified: Boolean&#xa;--&#xa;+ verify_password(plain: String): Bool&#xa;+ generate_jwt(): TokenPair" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#1E3A8A;fontColor=#FFFFFF;strokeColor=#1E3A8A;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="220" height="170" as="geometry" />
        </mxCell>

        <!-- Faculty Profile Class -->
        <mxCell id="c_faculty" value="FacultyProfile&#xa;--&#xa;+ id: UUID&#xa;+ department: String&#xa;+ title: String&#xa;+ tier: Integer (1-3)&#xa;+ slots_used: Integer&#xa;+ slots_total: Integer&#xa;+ h_index: Integer&#xa;--&#xa;+ has_available_slot(): Bool&#xa;+ decrement_slot(): Void" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#0284C7;fontColor=#FFFFFF;strokeColor=#0284C7;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="220" height="180" as="geometry" />
        </mxCell>

        <!-- Proposal Class -->
        <mxCell id="c_proposal" value="Proposal&#xa;--&#xa;+ id: UUID&#xa;+ title: String&#xa;+ problem_statement: Text&#xa;+ status: ProposalState&#xa;+ fit_score: Float&#xa;+ created_at: DateTime&#xa;--&#xa;+ transition_to(new_state: State)&#xa;+ evaluate_sla(): Bool" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#16A34A;fontColor=#FFFFFF;strokeColor=#16A34A;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="240" height="170" as="geometry" />
        </mxCell>

        <!-- Milestone Class -->
        <mxCell id="c_milestone" value="Milestone&#xa;--&#xa;+ id: UUID&#xa;+ title: String&#xa;+ due_date: Date&#xa;+ status: MilestoneStatus&#xa;+ submission_url: String&#xa;--&#xa;+ mark_completed(score: Float)&#xa;+ is_overdue(): Bool" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#D97706;fontColor=#FFFFFF;strokeColor=#D97706;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="340" width="240" height="160" as="geometry" />
        </mxCell>

        <!-- Meeting Room Class -->
        <mxCell id="c_room" value="MeetingRoom&#xa;--&#xa;+ id: UUID&#xa;+ room_code: String&#xa;+ scheduled_time: DateTime&#xa;+ is_active: Boolean&#xa;+ chat_history: JSON&#xa;--&#xa;+ start_consultation()&#xa;+ append_chat_message(msg)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#7C3AED;fontColor=#FFFFFF;strokeColor=#7C3AED;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="220" height="160" as="geometry" />
        </mxCell>

        <!-- Audit Ledger Class -->
        <mxCell id="c_audit" value="AuditLedger&#xa;--&#xa;+ id: Integer&#xa;+ action_type: String&#xa;+ entity_id: UUID&#xa;+ timestamp: DateTime&#xa;+ prev_hash: String&#xa;+ merkle_root: String&#xa;--&#xa;+ compute_sha256_block()&#xa;+ verify_hash_integrity(): Bool" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#475569;fontColor=#FFFFFF;strokeColor=#475569;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="340" width="240" height="180" as="geometry" />
