        <mxCell id="app_rtc" value="&lt;b&gt;WebRTC &amp;amp; Messaging Hub&lt;/b&gt;&lt;br&gt;• RFC 6455 WebSockets&lt;br&gt;• Client-Side Deduplication&lt;br&gt;• MediaStream getUserMedia&lt;br&gt;• Web Audio Chime Synthesis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1E293B;fontSize=10.5;arcSize=6;" vertex="1" parent="app_layer">
